# Copy to .env at the repo root. `pnpm --filter backend dev` loads it.
# A variable already set in the shell wins over this file.

# Required. The server exits without it. Any non-empty string works locally.
ARENA_OPERATOR_TOKEN=local-dev-token

# Where runs are stored. Use a file, not :memory: — the dev server restarts on
# every edit, and a memory database drops the running race each time.
ARENA_DB=/tmp/arena-dev.db

# Origins allowed to call this server from a browser, comma separated.
# Leave empty to register no CORS at all.
ARENA_CORS_ORIGINS=http://localhost:3000

# Wallets allowed to sign in as operator, comma separated. This is Hardhat
# account 0, which the local chain profile also registers as the seed funder.
ARENA_OPERATOR_ADDRESSES=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Domains a SIWE message may claim. Required whenever the address list is set.
ARENA_SIWE_DOMAINS=localhost:3000

# local or base.
ARENA_CHAIN_PROFILE=local

# false keeps the seed signature in the browser, where the real event runs it.
# true lets the local funder key sign it for you.
ARENA_AUTO_SIGN=false

# true funds entrants from the local funder key as soon as they exist, which
# ends the funding phase before anyone can press a button. Leave it off to fund
# from the arena UI. Only the local profile reads this. See PR #46.
ARENA_LOCAL_FAUCET=false

# Absolute path to an ai.ctf.buidlguidl.com checkout. The challenge pack is
# assembled from it. Command substitution does not work in this file.
AI_CTF_REPO=/absolute/path/to/ai.ctf.buidlguidl.com

# Harness credentials. One missing credential fails the whole run, not just the
# entrant that needed it. codex reads ~/.codex/auth.json instead.
OPENROUTER_API_KEY=
# From `claude setup-token`. Claude Code reads ANTHROPIC_API_KEY first, so a
# stray API key silently overrides this one.
CLAUDE_CODE_OAUTH_TOKEN=
